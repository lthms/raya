variant: fcos
version: 1.5.0

passwd:
  users:
    - name: core
      ssh_authorized_keys: {{ authorized_keys | tojson }}

storage:
  files:
    - path: /etc/NetworkManager/system-connections/enp7s0.nmconnection
      mode: 0600
      contents:
        inline: |
          [connection]
          id=enp7s0
          type=ethernet
          interface-name=enp7s0

          [ethernet]
          mtu=1450

          [ipv4]
          method=manual
          address1={{ private_ip }}/32,{{ private_gateway }}
          route1=10.0.0.0/8,{{ private_gateway }}
          may-fail=false

          [ipv6]
          method=disabled
    - path: /etc/tmpfiles.d/k3s.conf
      mode: 0644
      contents:
        inline: |
          Z /var/usrlocal/bin
    - path: /usr/local/bin/k3s-init.sh
      mode: 0755
      contents:
        inline: |
          #!/usr/bin/env bash
          set -euo pipefail

          CONFIG_DIR="/etc/rancher/k3s/config.yaml.d"

          public_ip="$(ip -4 -o addr show enp1s0 | awk '{print $4}' | cut -d/ -f1)"

          if [ -z "${public_ip}" ]; then
              echo "could not determine this node's public address" >&2
              exit 1
          fi

          echo "public address: ${public_ip}"

          mkdir -p "${CONFIG_DIR}"
          cat >"${CONFIG_DIR}/50-public-ip.yaml" <<EOF
          node-external-ip: "${public_ip}"
          EOF
    - path: /etc/nftables/raya.nft
      mode: 0644
      contents:
        inline: |
          # Hetzner's metadata service tells whoever reaches 169.254.169.254
          # who this node is, so the pod network has no business there. Egress
          # from a pod is masqueraded to the node's address on its way out, and
          # the forward path is the last place the pod is still visible:
          #
          #   pod --[cni0]--> forward (here) --[masquerade]--> enp1s0
          #
          # A table of our own, hooked ahead of priority 0, rather than a rule
          # in the filter chains flannel and kube-proxy rewrite at will.
          table inet raya {}
          delete table inet raya

          table inet raya {
            chain forward {
              type filter hook forward priority -10; policy accept;

              # 10.42.0.0/16 is k3s' default cluster-cidr. Reject rather than
              # drop, so a client fails at once instead of hanging.
              ip saddr 10.42.0.0/16 ip daddr 169.254.169.254 reject with icmpx type admin-prohibited
            }
          }
{% filter trim|indent(4, true) %}{% block storage_files %}{% endblock %}{% endfilter %}

systemd:
  units:
    # Everything that has to be true before k3s can start
    - name: k3s-setup.target
      enabled: true
      contents: |
        [Unit]
        Description=Prerequisites for running k3s
        Requires=systemd-tmpfiles-setup.service
        After=systemd-tmpfiles-setup.service
        Wants=network-online.target
        After=network-online.target

        [Install]
        WantedBy=multi-user.target

    - name: k3s-init.service
      enabled: true
      contents: |
        [Unit]
        Description=Discover this node's public address for k3s
        Wants=network-online.target
        After=network-online.target
        Before=k3s-setup.target

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        ExecStart=/usr/local/bin/k3s-init.sh
        Restart=on-failure
        RestartSec=5s

        [Install]
        RequiredBy=k3s-setup.target

    # In place before k3s starts, so no pod ever races the rule.
    - name: metadata-guard.service
      enabled: true
      contents: |
        [Unit]
        Description=Keep the pod network away from the metadata service
        Before=k3s-setup.target

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        ExecStart=/usr/sbin/nft -f /etc/nftables/raya.nft

        [Install]
        RequiredBy=k3s-setup.target
{% filter trim|indent(4, true) %}{% block systemd_units %}{% endblock %}{% endfilter %}
