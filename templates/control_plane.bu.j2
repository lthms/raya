{% extends "base.bu.j2" %}

{% block storage_files %}
- path: /etc/rancher/k3s/config.yaml
  mode: 0600
  contents:
    inline: |
      token: "{{ k3s_token }}"
      node-name: {{ node_name }}
      bind-address: {{ private_ip }}
      node-ip: {{ private_ip }}
      advertise-address: {{ private_ip }}
      flannel-iface: enp7s0
      disable: local-storage

- path: /usr/local/bin/k3s-sync-manifests.sh
  mode: 0755
  contents:
    inline: |
      #!/usr/bin/env bash
      # Hand the manifests carried by the Ignition config to k3s's auto-deploy
      # directory.
      set -euo pipefail

      SRC=/etc/rancher/k3s/manifests
      DST=/var/lib/rancher/k3s/server/manifests

      mkdir -p "${DST}"

      find "${DST}" -maxdepth 1 -type l ! -exec test -e {} \; -print -delete

      # No match leaves the pattern itself, which is not a file.
      for f in "${SRC}"/*.yaml; do
          [ -f "${f}" ] || continue
          ln -sfn "${f}" "${DST}/$(basename "${f}")"
      done

- path: /etc/rancher/k3s/manifests/traefik-config.yaml
  mode: 0644
  contents:
    inline: |
{% filter trim|indent(6, true) %}{% include "manifests/traefik-config.yaml" %}{% endfilter %}

- path: /etc/rancher/k3s/manifests/gcp-dns-secret.yaml
  mode: 0600
  contents:
    inline: |
{% filter trim|indent(6, true) %}{% include "manifests/gcp-dns-secret.yaml" %}{% endfilter %}

- path: /etc/rancher/k3s/manifests/flux.yaml
  mode: 0644
  contents:
    inline: |
{% filter trim|indent(6, true) %}{% include "manifests/flux.yaml" %}{% endfilter %}
- path: /etc/rancher/k3s/manifests/sops-age-secret.yaml
  mode: 0600
  contents:
    inline: |
{% filter trim|indent(6, true) %}{% include "manifests/sops-age-secret.yaml" %}{% endfilter %}
- path: /etc/rancher/k3s/manifests/cluster-vars.yaml
  mode: 0644
  contents:
    inline: |
{% filter trim|indent(6, true) %}{% include "manifests/cluster-vars.yaml" %}{% endfilter %}
{% endblock %}

{% block systemd_units %}
- name: mkfs-k3s-volume.service
  contents: |
    [Unit]
    Description=Create a filesystem on the k3s volume if it has none
    After={{ k3s_volume_device_unit }}
    Requires={{ k3s_volume_device_unit }}

    [Service]
    Type=oneshot
    RemainAfterExit=yes
    ExecStart=/bin/bash -c 'blkid {{ k3s_volume_device }} | grep -q TYPE || mkfs.xfs {{ k3s_volume_device }}'

- name: var-lib-rancher-k3s.mount
  enabled: true
  contents: |
    [Unit]
    Description=Mount the k3s data volume
    DefaultDependencies=no
    Requires=mkfs-k3s-volume.service
    After=mkfs-k3s-volume.service local-fs.target
    Before=k3s-setup.target
    Conflicts=umount.target
    Before=umount.target

    [Mount]
    What={{ k3s_volume_device }}
    Where=/var/lib/rancher/k3s
    Type=xfs

    [Install]
    RequiredBy=k3s-setup.target

- name: k3s-sync-manifests.service
  enabled: true
  contents: |
    [Unit]
    Description=Sync the auto-deploy manifests into the k3s data directory
    # Ordered after the seeding, which wipes server/ when it re-bootstraps.
    Before=k3s-setup.target

    [Service]
    Type=oneshot
    RemainAfterExit=yes
    ExecStart=/usr/local/bin/k3s-sync-manifests.sh

    [Install]
    RequiredBy=k3s-setup.target

- name: k3s.service
  enabled: true
  contents: |
    [Unit]
    Description=Lightweight Kubernetes
    Documentation=https://k3s.io
    Requires=k3s-setup.target
    After=k3s-setup.target

    [Service]
    Type=notify
    ExecStartPre=-/sbin/modprobe br_netfilter
    ExecStartPre=-/sbin/modprobe overlay
    ExecStart=/usr/local/bin/k3s server
    KillMode=process
    Delegate=yes
    Restart=always
    RestartSec=5s
    TimeoutStartSec=0
    LimitNOFILE=1048576
    LimitNPROC=infinity
    LimitCORE=infinity
    TasksMax=infinity

    [Install]
    WantedBy=multi-user.target
{% endblock %}
