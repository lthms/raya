{% extends "base.bu.j2" %}

{% block storage_files %}
- path: /etc/rancher/k3s/config.yaml
  mode: 0600
  contents:
    inline: |
      token: "{{ k3s_token }}"
      bind-address: {{ private_ip }}
      node-ip: {{ private_ip }}
      advertise-address: {{ private_ip }}
      flannel-iface: enp7s0
      disable: local-storage

- path: /etc/rancher/k3s/tls/server-ca.crt
  mode: 0644
  contents:
    inline: |
      {{ server_ca_cert | indent(6) }}
- path: /etc/rancher/k3s/tls/server-ca.key
  mode: 0600
  contents:
    inline: |
      {{ server_ca_key | indent(6) }}
- path: /etc/rancher/k3s/tls/client-ca.crt
  mode: 0644
  contents:
    inline: |
      {{ client_ca_cert | indent(6) }}
- path: /etc/rancher/k3s/tls/client-ca.key
  mode: 0600
  contents:
    inline: |
      {{ client_ca_key | indent(6) }}

- path: /usr/local/bin/k3s-seed-pki.sh
  mode: 0755
  contents:
    inline: |
      #!/usr/bin/env bash
      # Make the data directory on the volume agree with the Ignition config: put
      # the CAs in place, and re-bootstrap the node when the config has moved on.
      # Ignition cannot do this itself — the volume is not mounted when it runs.
      #
      # When neither has changed, this is a no-op, so an ordinary reboot costs
      # nothing.
      set -euo pipefail

      SRC=/etc/rancher/k3s/tls
      DATA_DIR=/var/lib/rancher/k3s
      DST="${DATA_DIR}/server/tls"
      CONFIG=/etc/rancher/k3s/config.yaml
      TOKEN_FILE="${DATA_DIR}/server/token"

      configured_token="$(sed -n 's/^token: "\(.*\)"$/\1/p' "${CONFIG}")"
      if [ -z "${configured_token}" ]; then
          echo "no token found in ${CONFIG}" >&2
          exit 1
      fi

      reason=""

      # k3s records its own token in K10<hash>::server:<secret> form. On a fresh
      # volume the file is absent, which is not a change.
      if [ -f "${TOKEN_FILE}" ]; then
          recorded="$(cat "${TOKEN_FILE}")"
          recorded="${recorded#*::}"
          recorded="${recorded#server:}"
          if [ "${recorded}" != "${configured_token}" ]; then
              reason="the cluster token changed"
          fi
      fi

      if [ -z "${reason}" ]; then
          for f in server-ca.crt server-ca.key client-ca.crt client-ca.key; do
              if ! cmp -s "${SRC}/${f}" "${DST}/${f}"; then
                  reason="the CA material changed"
                  break
              fi
          done
      fi

      if [ -z "${reason}" ]; then
          echo "volume already agrees with the config, nothing to do"
          exit 0
      fi

      echo "re-bootstrapping this node: ${reason}"

      # server/ holds the datastore, the CAs and everything signed by them;
      # agent/ holds this node's own kubelet certificates, which were issued by
      # those same CAs. Both are stale.
      rm -rf "${DATA_DIR}/server" "${DATA_DIR}/agent"
      mkdir -p "${DST}"

      install -o 0 -g 0 -m 0644 "${SRC}/server-ca.crt" "${DST}/server-ca.crt"
      install -o 0 -g 0 -m 0600 "${SRC}/server-ca.key" "${DST}/server-ca.key"
      install -o 0 -g 0 -m 0644 "${SRC}/client-ca.crt" "${DST}/client-ca.crt"
      install -o 0 -g 0 -m 0600 "${SRC}/client-ca.key" "${DST}/client-ca.key"

- path: /usr/local/bin/k3s-sync-manifests.sh
  mode: 0755
  contents:
    inline: |
      #!/usr/bin/env bash
      # Hand the manifests carried by the Ignition config to k3s's auto-deploy
      # directory.
      set -euo pipefail

      SRC=/etc/rancher/k3s/manifests
      DST=/var/lib/rancher/k3s/server/manifests

      mkdir -p "${DST}"

      find "${DST}" -maxdepth 1 -type l ! -exec test -e {} \; -print -delete

      # No match leaves the pattern itself, which is not a file.
      for f in "${SRC}"/*.yaml; do
          [ -f "${f}" ] || continue
          ln -sfn "${f}" "${DST}/$(basename "${f}")"
      done

- path: /etc/rancher/k3s/manifests/traefik-config.yaml
  mode: 0644
  contents:
    inline: |
{% filter trim|indent(6, true) %}{% include "manifests/traefik-config.yaml" %}{% endfilter %}

- path: /etc/rancher/k3s/manifests/external-dns.yaml
  mode: 0644
  contents:
    inline: |
{% filter trim|indent(6, true) %}{% include "manifests/external-dns.yaml" %}{% endfilter %}
- path: /etc/rancher/k3s/manifests/gcp-dns-secret.yaml
  mode: 0600
  contents:
    inline: |
{% filter trim|indent(6, true) %}{% include "manifests/gcp-dns-secret.yaml" %}{% endfilter %}

- path: /etc/rancher/k3s/manifests/cert-manager.yaml
  mode: 0644
  contents:
    inline: |
{% filter trim|indent(6, true) %}{% include "manifests/cert-manager.yaml" %}{% endfilter %}
# Applied before cert-manager has registered its CRDs, hence rejected on the
# first pass; k3s' deploy controller keeps retrying until it lands.
- path: /etc/rancher/k3s/manifests/cluster-issuer.yaml
  mode: 0644
  contents:
    inline: |
{% filter trim|indent(6, true) %}{% include "manifests/cluster-issuer.yaml" %}{% endfilter %}

- path: /etc/rancher/k3s/manifests/hcloud-csi.yaml
  mode: 0644
  contents:
    inline: |
{% filter trim|indent(6, true) %}{% include "manifests/hcloud-csi.yaml" %}{% endfilter %}
- path: /etc/rancher/k3s/manifests/hcloud-csi-secret.yaml
  mode: 0600
  contents:
    inline: |
{% filter trim|indent(6, true) %}{% include "manifests/hcloud-csi-secret.yaml" %}{% endfilter %}

- path: /etc/rancher/k3s/manifests/flux.yaml
  mode: 0644
  contents:
    inline: |
{% filter trim|indent(6, true) %}{% include "manifests/flux.yaml" %}{% endfilter %}
- path: /etc/rancher/k3s/manifests/sops-age-secret.yaml
  mode: 0600
  contents:
    inline: |
{% filter trim|indent(6, true) %}{% include "manifests/sops-age-secret.yaml" %}{% endfilter %}

- path: /etc/rancher/k3s/manifests/hello.yaml
  mode: 0644
  contents:
    inline: |
{% filter trim|indent(6, true) %}{% include "manifests/hello.yaml" %}{% endfilter %}
{% endblock %}

{% block systemd_units %}
- name: mkfs-k3s-volume.service
  contents: |
    [Unit]
    Description=Create a filesystem on the k3s volume if it has none
    After={{ k3s_volume_device_unit }}
    Requires={{ k3s_volume_device_unit }}

    [Service]
    Type=oneshot
    RemainAfterExit=yes
    ExecStart=/bin/bash -c 'blkid {{ k3s_volume_device }} | grep -q TYPE || mkfs.xfs {{ k3s_volume_device }}'

- name: var-lib-rancher-k3s.mount
  enabled: true
  contents: |
    [Unit]
    Description=Mount the k3s data volume
    DefaultDependencies=no
    Requires=mkfs-k3s-volume.service
    After=mkfs-k3s-volume.service local-fs.target
    Before=k3s-setup.target
    Conflicts=umount.target
    Before=umount.target

    [Mount]
    What={{ k3s_volume_device }}
    Where=/var/lib/rancher/k3s
    Type=xfs

    [Install]
    RequiredBy=k3s-setup.target

- name: k3s-seed-pki.service
  enabled: true
  contents: |
    [Unit]
    Description=Reconcile the k3s data directory with the Ignition config
    Requires=var-lib-rancher-k3s.mount
    After=var-lib-rancher-k3s.mount
    Before=k3s-setup.target

    [Service]
    Type=oneshot
    RemainAfterExit=yes
    ExecStart=/usr/local/bin/k3s-seed-pki.sh

    [Install]
    RequiredBy=k3s-setup.target

- name: k3s-sync-manifests.service
  enabled: true
  contents: |
    [Unit]
    Description=Sync the auto-deploy manifests into the k3s data directory
    # Ordered after the seeding, which wipes server/ when it re-bootstraps.
    Requires=k3s-seed-pki.service
    After=k3s-seed-pki.service
    Before=k3s-setup.target

    [Service]
    Type=oneshot
    RemainAfterExit=yes
    ExecStart=/usr/local/bin/k3s-sync-manifests.sh

    [Install]
    RequiredBy=k3s-setup.target

- name: k3s.service
  enabled: true
  contents: |
    [Unit]
    Description=Lightweight Kubernetes
    Documentation=https://k3s.io
    Requires=k3s-setup.target
    After=k3s-setup.target

    [Service]
    Type=notify
    ExecStartPre=-/sbin/modprobe br_netfilter
    ExecStartPre=-/sbin/modprobe overlay
    ExecStart=/usr/local/bin/k3s server
    KillMode=process
    Delegate=yes
    Restart=always
    RestartSec=5s
    TimeoutStartSec=0
    LimitNOFILE=1048576
    LimitNPROC=infinity
    LimitCORE=infinity
    TasksMax=infinity

    [Install]
    WantedBy=multi-user.target
{% endblock %}
